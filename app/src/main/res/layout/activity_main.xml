<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mesh_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/mesh_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meshStatusView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mesh_idle"
                android:textColor="@color/mesh_teal"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/integrityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/signed_mesh"
            android:textColor="@color/mesh_teal"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/nodeIdInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_composer"
                android:hint="@string/node_id_hint"
                android:inputType="textCapCharacters"
                android:maxLength="12"
                android:padding="10dp"
                android:text="A"
                android:textColor="@color/mesh_text"
                android:textColorHint="@color/mesh_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/startListeningButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/start_listening" />
        </LinearLayout>

        <TextView
            android:id="@+id/connectionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_connections"
            android:textColor="@color/mesh_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/setupToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:text="@string/show_setup"
            android:textColor="@color/mesh_teal" />

        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/enableBluetoothButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_bluetooth" />

            <Button
                android:id="@+id/makeDiscoverableButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/make_discoverable" />

            <Button
                android:id="@+id/discoverPeersButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/discover_peers" />

            <Spinner
                android:id="@+id/peerSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_composer"
                android:padding="8dp" />

            <Button
                android:id="@+id/connectSelectedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_selected_peer" />

            <Button
                android:id="@+id/updateFromGithubButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_from_github" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="#050B14"
                android:padding="8dp"
                android:text="Logs will appear here..."
                android:textColor="@color/mesh_muted"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/fileProgressView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="@string/no_file_transfer"
        android:textColor="@color/mesh_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mesh_surface"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/destinationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_composer"
            android:hint="@string/destination_hint"
            android:inputType="textCapCharacters"
            android:padding="10dp"
            android:textColor="@color/mesh_text"
            android:textColorHint="@color/mesh_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_composer"
                android:gravity="top|start"
                android:hint="@string/message_hint"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/mesh_text"
                android:textColorHint="@color/mesh_muted" />

            <Button
                android:id="@+id/sendFileButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="@string/file_button" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:text="@string/send_button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
